<ClientProfile name="Android Phone (generalized)" family="Android" deviceType="Mobile"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="../schema/profile.xsd">

    <DirectPlay>
        <VideoCodec>h264</VideoCodec>
        <VideoCodec>hevc</VideoCodec>
        <AudioCodec>aac</AudioCodec>
        <AudioCodec>ac3</AudioCodec>
        <Container>mp4</Container>
        <Container>mkv</Container>
    </DirectPlay>

    <DirectStream>
        <VideoCodec>h264</VideoCodec>
        <VideoCodec>hevc</VideoCodec>
        <AudioCodec>aac</AudioCodec>
        <AudioCodec>ac3</AudioCodec>
        <Container>mkv</Container>
        <Container>ts</Container>
    </DirectStream>

    <Preferred>
        <VideoCodec>h264</VideoCodec>
        <AudioCodec>aac</AudioCodec>
        <Container>mp4</Container>
    </Preferred>

    <Limits>
        <MaxWidth>1920</MaxWidth>
        <MaxHeight>1080</MaxHeight>
        <MaxAudioChannels>2</MaxAudioChannels>
    </Limits>

    <Requirements>
        <StrictH264>false</StrictH264>
        <BitDepth>8</BitDepth>
        <ForceStereoDownmix>true</ForceStereoDownmix>
    </Requirements>

    <Subtitles>
        <Internal>true</Internal>
        <External>true</External>
        <SRT>true</SRT>
        <PGS>false</PGS>
        <MovText>true</MovText>
    </Subtitles>

    <Description>Android Phone DirectPlay profile</Description>

</ClientProfile>

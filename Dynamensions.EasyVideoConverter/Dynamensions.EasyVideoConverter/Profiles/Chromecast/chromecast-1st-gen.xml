<ClientProfile name="Chromecast 1st Gen (2015)" family="Chromecast" deviceType="StreamingDongle"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="../schema/profile.xsd">

    <DirectPlay>
        <VideoCodec>h264</VideoCodec>
        <AudioCodec>aac</AudioCodec>
        <AudioCodec>mp3</AudioCodec>
        <Container>mp4</Container>
        <Container>webm</Container>
    </DirectPlay>

    <DirectStream>
        <VideoCodec>h264</VideoCodec>
        <AudioCodec>aac</AudioCodec>
        <Container>ts</Container>
    </DirectStream>

    <Preferred>
        <VideoCodec>h264</VideoCodec>
        <AudioCodec>aac</AudioCodec>
        <Container>mp4</Container>
    </Preferred>

    <Limits>
        <MaxWidth>1280</MaxWidth>
        <MaxHeight>720</MaxHeight>
        <MaxAudioChannels>2</MaxAudioChannels>
    </Limits>

    <Requirements>
        <StrictH264>true</StrictH264>
        <Profile>high</Profile>
        <Level>4.0</Level>
        <BitDepth>8</BitDepth>
        <ForceStereoDownmix>true</ForceStereoDownmix>
    </Requirements>

    <Subtitles>
        <Internal>false</Internal>
        <External>true</External>
        <SRT>true</SRT>
        <PGS>false</PGS>
        <MovText>false</MovText>
    </Subtitles>

    <Description>Chromecast 1st Gen DirectPlay profile</Description>

</ClientProfile>

<ClientProfile name="Roku Stick" family="Roku" deviceType="StreamingDongle"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="../schema/profile.xsd">

    <DirectPlay>
        <VideoCodec>h264</VideoCodec>
        <AudioCodec>aac</AudioCodec>
        <AudioCodec>mp3</AudioCodec>
        <Container>mp4</Container>
    </DirectPlay>

    <DirectStream>
        <VideoCodec>h264</VideoCodec>
        <AudioCodec>aac</AudioCodec>
        <Container>mkv</Container>
        <Container>ts</Container>
    </DirectStream>

    <Preferred>
        <VideoCodec>h264</VideoCodec>
        <AudioCodec>aac</AudioCodec>
        <Container>mp4</Container>
    </Preferred>

    <Limits>
        <MaxWidth>1920</MaxWidth>
        <MaxHeight>1080</MaxHeight>
        <MaxAudioChannels>2</MaxAudioChannels>
    </Limits>

    <Requirements>
        <StrictH264>true</StrictH264>
        <Profile>high</Profile>
        <Level>4.1</Level>
        <BitDepth>8</BitDepth>
        <ForceStereoDownmix>true</ForceStereoDownmix>
    </Requirements>

    <Subtitles>
        <Internal>false</Internal>
        <External>true</External>
        <SRT>true</SRT>
        <PGS>false</PGS>
        <MovText>false</MovText>
    </Subtitles>

    <Description>Roku Streaming Stick DirectPlay profile</Description>

</ClientProfile>

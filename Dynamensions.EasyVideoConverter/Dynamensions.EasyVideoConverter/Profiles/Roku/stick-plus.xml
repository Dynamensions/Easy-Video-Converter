<ClientProfile name="Roku Stick Plus" family="Roku" deviceType="StreamingDongle"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="../schema/profile.xsd">

    <DirectPlay>
        <VideoCodec>h264</VideoCodec>
        <VideoCodec>hevc</VideoCodec>
        <AudioCodec>aac</AudioCodec>
        <AudioCodec>ac3</AudioCodec>
        <AudioCodec>eac3</AudioCodec>
        <Container>mp4</Container>
        <Container>mkv</Container>
    </DirectPlay>

    <DirectStream>
        <VideoCodec>h264</VideoCodec>
        <VideoCodec>hevc</VideoCodec>
        <AudioCodec>aac</AudioCodec>
        <AudioCodec>ac3</AudioCodec>
        <AudioCodec>eac3</AudioCodec>
        <Container>mkv</Container>
        <Container>ts</Container>
    </DirectStream>

    <Preferred>
        <VideoCodec>hevc</VideoCodec>
        <AudioCodec>eac3</AudioCodec>
        <Container>mkv</Container>
    </Preferred>

    <Limits>
        <MaxWidth>3840</MaxWidth>
        <MaxHeight>2160</MaxHeight>
        <MaxAudioChannels>6</MaxAudioChannels>
    </Limits>

    <Requirements>
        <StrictH264>false</StrictH264>
        <BitDepth>8</BitDepth>
        <ForceStereoDownmix>false</ForceStereoDownmix>
        <RequiresAacStereoFallback>true</RequiresAacStereoFallback>
    </Requirements>

    <Subtitles>
        <Internal>true</Internal>
        <External>true</External>
        <SRT>true</SRT>
        <PGS>true</PGS>
        <MovText>false</MovText>
    </Subtitles>

    <Description>Roku Streaming Stick+ DirectPlay profile</Description>

</ClientProfile>

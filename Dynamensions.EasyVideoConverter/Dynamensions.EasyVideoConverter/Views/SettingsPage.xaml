<Page
    x:Class="Dynamensions.EasyVideoConverter.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Dynamensions.EasyVideoConverter.Core.ViewModels"
    xmlns:stModels="using:Dynamensions.EasyVideoConverter.Core.Models.Subtitles"
    xmlns:converters="using:Dynamensions.EasyVideoConverter.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <Page.Resources>
        <converters:NullToOpacityConverter x:Key="NullToOpacityConverter" />
    </Page.Resources>

    <ScrollViewer Padding="32">
        <StackPanel Spacing="24">
            <StackPanel>
                <TextBlock Style="{StaticResource SubheaderTextBlockStyle}">Video</TextBlock>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}">Video options.</TextBlock>
            </StackPanel>

            <!-- ========================= -->
            <!-- Video Section -->
            <!-- ========================= -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">Size Options</TextBlock>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="Upscale video (if source is smaller than target, the video will be unscaled)"
                              IsChecked="{Binding IsUpscalingVideo, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Text="Converted videos will be saved to this folder."
                           FontSize="12"
                           Opacity="0.7"/>
            </StackPanel>

            <Rectangle Height="1" Stroke="LightGray" />

            <!-- ========================= -->
            <!-- Subtitle Languages Section -->
            <!-- ========================= -->
            <StackPanel>
                <TextBlock Style="{StaticResource SubheaderTextBlockStyle}">Subtitles</TextBlock>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}">Subtitles options are only used when the video file contains subtitles.</TextBlock>
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubheaderTextBlockStyle}"
                    Text="Preferred Subtitle Languages"
                           FontSize="24"
                           FontWeight="SemiBold"/>

                <Border Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">

                    <ListView ItemsSource="{Binding Languages}"
                              SelectionMode="None"
                              Height="280">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="stModels:SubtitleLanguageItem">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind Name}" FontSize="18"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>
                </Border>
      
            </StackPanel>

            <Rectangle Height="1" Stroke="LightGray" />
         
            
            <!-- ========================= -->
            <!-- Burn-in Subtitle Section -->
            <!-- ========================= -->
            <StackPanel Spacing="12">
                <TextBlock Text="Burn-In Subtitle Language"
                           FontSize="24"
                           FontWeight="SemiBold"/>

                <ComboBox ItemsSource="{Binding BurninLanguages}"
                          SelectedItem="{Binding SelectedBurnInLanguage, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Width="300"/>

                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Text="Burned-in subtitles become part of the video and cannot be turned off."
                           Opacity="{Binding SelectedBurnInLanguage, Converter={StaticResource NullToOpacityConverter}}"/>
            </StackPanel>

            <Rectangle Height="1" Stroke="LightGray" />


            <StackPanel>
                <TextBlock Style="{StaticResource SubheaderTextBlockStyle}">Files</TextBlock>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}">Options for file naming and location.</TextBlock>
            </StackPanel>

            <!-- ========================= -->
            <!-- Append Filename -->
            <!-- ========================= -->
            <StackPanel Spacing="12">
                <TextBlock Text="Append Video Properties To Filename"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                
                <ComboBox ItemsSource="{Binding FilenamePatternPresets}"
                          SelectedItem="{Binding SelectedFilenamePatternPreset, Mode=TwoWay}"
                          Width="300"/>

                <TextBlock FontSize="12"
                           Text="{Binding FilenamePreview, Mode=OneWay}"
                           Opacity="{Binding SelectedBurnInLanguage, Converter={StaticResource NullToOpacityConverter}}"/>
            </StackPanel>

            <!-- ========================= -->
            <!-- Output Directory Section -->
            <!-- ========================= -->
            <StackPanel Spacing="12">
                <TextBlock Text="Output Directory"
               FontSize="24"
               FontWeight="SemiBold"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding OutputDirectory, Mode=TwoWay}"
                             Width="400"
                             PlaceholderText="Select an output directory..." />

                    <Button Content="Browse"
                            Command="{Binding BrowseOutputDirectoryCommand}"
                            Width="100"/>
                </StackPanel>

                <TextBlock Text="Converted videos will be saved to this folder."
                           FontSize="12"
                           Opacity="0.7"/>
            </StackPanel>

            <Rectangle Height="1" Stroke="LightGray" />

            <StackPanel>
                <TextBlock Style="{StaticResource SubheaderTextBlockStyle}">FFMPEG</TextBlock>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}">Options for FFMPEG.</TextBlock>
            </StackPanel>
            <!-- ========================= -->
            <!-- FFMPEG LOCATIONS -->
            <!-- ========================= -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="FFMPEG Binaries" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Browse"
                            Command="{Binding BrowseFFMpegPathCommand}"
                            Width="100"/>
                </StackPanel>
                <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                           Text="Browse to a directory containing FFMPEG binaries you would like to use. Easy Video Creator will copy the files needed from the selected folder and place them into it's install directory. It will not run them from the browsed location."/>

                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Text="NOTE: Not all FFMPEG versions are capable of every encoding possible. For best results choose the full version. To abide with copyright, this app was shipped with LGPL FFMPEG binaries. Browse to the GPL or Full versions to unlock the full speed of FFMPEG." />
                
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                    For the latest full FFMPEG Binaries, click <Hyperlink NavigateUri="https://www.gyan.dev/ffmpeg/builds/ffmpeg-git-full.7z" Click="InlineHyperlink_Click">here</Hyperlink>. 
                    For all FFMPEG Binaries, click <Hyperlink NavigateUri="https://ffmpeg.org/download.html" Click="InlineHyperlink_Click">here.</Hyperlink>.
                </TextBlock>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                    Be sure your binary is compiled in the same architecture as your system (e.g. x64 or arm64).
                </TextBlock>
            </StackPanel>

            <Rectangle Height="1" Stroke="LightGray" />

            <!-- ========================= -->
            <!-- Save Button -->
            <!-- ========================= -->
            
            <Button Content="Save Settings"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Left"
                    Width="200"
                    Margin="0,12,0,0"/>
            
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Text="Save your changes." />

            <!-- FFMPEG -->
            <StackPanel>
                <TextBlock Text="Portions of this app uses FFMPEG"/>
                <Image Source="/Assets/Icons/ffmpeg7597.jpg" Width="60" HorizontalAlignment="Left" />
            </StackPanel>

        </StackPanel>
        
        
    </ScrollViewer>
</Page>


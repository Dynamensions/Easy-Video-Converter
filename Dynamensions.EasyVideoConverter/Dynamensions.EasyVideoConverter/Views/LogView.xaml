<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Dynamensions.EasyVideoConverter.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dynamensions.EasyVideoConverter.Views"
    xmlns:converters="using:Dynamensions.EasyVideoConverter.Converters"
    xmlns:models="using:Dynamensions.EasyVideoConverter.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
    </Page.Resources>

    <Grid Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <TextBlock Style="{StaticResource HeaderTextBlockStyle}">Logs</TextBlock>

        <SplitView x:Name="LogSplitView"
                   DisplayMode="Inline"
                   IsPaneOpen="True"
                   OpenPaneLength="350"
                   Grid.Row="1">

            <SplitView.Pane>
                <ListView x:Name="LogListView"
                          SelectedItem="{x:Bind viewModel.SelectedLog, Mode=TwoWay}"
                          ItemsSource="{x:Bind viewModel.LogEntries}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:LogEntry">
                            <StackPanel Padding="8">
                                <TextBlock Text="{x:Bind Timestamp}"
                                           FontSize="12"/>
                                <TextBlock Text="{x:Bind FileName}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </SplitView.Pane>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CommandBar Grid.Row="0">
                    <AppBarButton Icon="Delete"
                                  Label="Delete Log"
                                  Command="{x:Bind viewModel.DeleteLogCommand}" />
                    
                    <AppBarButton Icon="Clear"
                                  Label="Delete All Logs"
                                  Command="{x:Bind viewModel.DeleteAllLogsCommand}" />

                </CommandBar>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0"
                          Padding="8,4"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Timestamp"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Column="1"
                                   Text="Level"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Column="2"
                                   Text="Message"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Log Entries -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

                        <ItemsRepeater ItemsSource="{x:Bind viewModel.LogLines, Mode=OneWay}">

                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical"/>
                            </ItemsRepeater.Layout>

                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:LogLine">

                                    <Grid Padding="8,2" Background="{x:Bind RowBackground}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind TimestampText}"
                                                   FontFamily="Consolas"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Level}"
                                                   Foreground="{x:Bind LevelBrush}"
                                                   FontFamily="Consolas"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Message}"
                                                   FontFamily="Consolas"
                                                   TextWrapping="NoWrap"/>
                                    </Grid>

                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>

                        </ItemsRepeater>

                    </ScrollViewer>
                </Grid>
            </Grid>

        </SplitView>


    </Grid>
</Page>

<Page
    x:Class="Dynamensions.EasyVideoConverter.Views.BootstrapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Dynamensions.EasyVideoConverter.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Dynamensions.EasyVideoConverter.Core.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:BootstrapViewModel}"
    Loaded="Page_Loaded">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid CornerRadius="12"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          Padding="36"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Translation="0,0,32">

            <Grid.Shadow>
                <ThemeShadow/>
            </Grid.Shadow>

            <StackPanel Spacing="32">

                <!-- Header -->
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE9F5;" FontSize="48"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="EasyVideoConverter Setup"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Confirm Dependencies -->
                <StackPanel Spacing="20"
                            Visibility="{x:Bind viewModel.IsConfirmingPrepare, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Text="Missing Application Dependencies"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock FontSize="14"
                               TextWrapping="WrapWholeWords"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        Before you can use Easy Video Converter, required components must be downloaded.
                    </TextBlock>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Command="{x:Bind viewModel.PrepareApplicationCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Download Dependencies"
                                HorizontalAlignment="Center"
                                Width="200"
                                MinHeight="40"/>

                        <Button Command="{x:Bind viewModel.CancelCommand}"
                                Style="{StaticResource ButtonRevealStyle}"
                                Content="Cancel and Exit"
                                Width="200"
                                HorizontalAlignment="Center"
                                Grid.Column="1"
                                MinHeight="40"/>
                    </Grid>
                </StackPanel>

                <!-- Preparing -->
                <StackPanel Spacing="20" Width="600"
                            Visibility="{x:Bind viewModel.IsConfirmingPrepare, Mode=OneWay, Converter={StaticResource BoolToVisibilityInvertedConverter}}">

                    <TextBlock Text="Preparing Application"
                               FontSize="22"
                               FontWeight="SemiBold"/>

                    <Border Background="{ThemeResource SubtleFillColorTransparentBrush}"
                            Padding="12"
                            CornerRadius="6">
                        <TextBlock Text="{x:Bind viewModel.StatusMessage, Mode=OneWay}"
                                   FontFamily="Cascadia Mono"
                                   FontSize="12"
                                   Height="26"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Border>

                    <Rectangle Height="1"
                               Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                               Margin="0,8,0,0"/>
                    
                    <ProgressBar Height="10"
                                 Value="{x:Bind viewModel.Percent, Mode=OneWay}"
                                 Visibility="{x:Bind viewModel.IsPercentVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock Text="{x:Bind viewModel.PercentMessage, Mode=OneWay}"
                               FontFamily="Cascadia Mono"
                               FontSize="12"
                               TextAlignment="Right"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Grid>

</Page>

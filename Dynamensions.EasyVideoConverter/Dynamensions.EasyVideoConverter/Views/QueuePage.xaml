<Page
    x:Class="Dynamensions.EasyVideoConverter.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Dynamensions.EasyVideoConverter.Core.ViewModels"
    xmlns:models="using:Dynamensions.EasyVideoConverter.Core.Models"
    xmlns:profileModels="using:Dynamensions.EasyVideoConverter.Core.Models.Profiles"
    xmlns:converters="using:Dynamensions.EasyVideoConverter.Converters"
    xmlns:controls="using:Dynamensions.EasyVideoConverter.Controls"
    mc:Ignorable="d"
    x:Name="RootPage"
    d:DataContext="{d:DesignInstance vm:QueueViewModel}">
    <Page.Resources>

        <!-- COLOR CONVERTER -->
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:LongToColorConverter x:Key="LongToColorConverter" />
        <converters:LongToFileSizeConverter x:Key="LongToFileSizeConverter" />

        <!-- Encoder Type -->
        <converters:EncoderTypeToColorConverter x:Key="EncoderTypeToColorConverter" />
        <converters:EncoderTypeToSvgIconConverter x:Key="EncoderTypeToSvgIconConverter" />
        <converters:EncoderNameToIconConverter x:Key="EncoderNameToIconConverter" />

        <converters:DeviceFamilyToIconConverter x:Key="DeviceFamilyToIconConverter" />
        <converters:GroupInfoListToFlatCollectionConverter x:Key="GroupInfoListToFlatCollectionConverter" />
        <converters:DeviceTypeToIconConverter x:Key="DeviceTypeToIconConverter" />

        <!-- GROUP HEADER -->
        <converters:ComboBoxItemTemplateSelector x:Key="ComboBoxItemTemplateSelector">
            <converters:ComboBoxItemTemplateSelector.GroupHeaderTemplate>
                <DataTemplate x:DataType="profileModels:ClientProfileGroup">
                    <Border Background="#BDC3C7" Height="40" Padding="8">
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#1E90FF"
                                   IsHitTestVisible="False"
                                   Text="{x:Bind Key}" />
                    </Border>
                </DataTemplate>
            </converters:ComboBoxItemTemplateSelector.GroupHeaderTemplate>
            <converters:ComboBoxItemTemplateSelector.ItemTemplate>
                <DataTemplate x:DataType="profileModels:ClientProfile" >
                    <StackPanel Orientation="Horizontal" Spacing="12">

                        <!-- Device Icon -->
                        <Image Width="24" Height="24"
                               Source="{Binding DeviceType, Converter={StaticResource DeviceTypeToIconConverter}}"/>

                        <!-- Device Name + Description -->
                        <StackPanel Spacing="1">
                            <TextBlock Text="{x:Bind Name}"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                            
                            <TextBlock Text="{x:Bind DeviceFamily}"
                                       FontSize="12"
                                       Opacity="0.7" />

                            <TextBlock Text="{x:Bind Capabilities}"
                                       FontSize="12"
                                       Opacity="0.6" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </converters:ComboBoxItemTemplateSelector.ItemTemplate>
        </converters:ComboBoxItemTemplateSelector>

        <converters:ComboBoxContainerStyleSelector x:Key="ComboBoxContainerStyleSelector">
            <converters:ComboBoxContainerStyleSelector.GroupHeaderStyle>
                <Style BasedOn="{StaticResource DefaultComboBoxItemStyle}" TargetType="ComboBoxItem">
                    <Setter Property="IsEnabled" Value="False" />
                </Style>
            </converters:ComboBoxContainerStyleSelector.GroupHeaderStyle>
            <converters:ComboBoxContainerStyleSelector.ItemStyle>
                <Style BasedOn="{StaticResource DefaultComboBoxItemStyle}" TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="24,0,0,0" />
                </Style>
            </converters:ComboBoxContainerStyleSelector.ItemStyle>
        </converters:ComboBoxContainerStyleSelector>
    </Page.Resources>


    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="24">

            <!-- HEADER -->
            <TextBlock Text="Transcode Queue"
                       FontSize="34"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <!-- PROFILE SELECTION -->
            <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="24">

                    <!-- ENCODER PROFILE -->
                    <StackPanel Width="560" Spacing="6">

                        <TextBlock Text="Encoder"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>

                        <ComboBox ItemsSource="{Binding EncoderProfiles}"
                                  SelectedItem="{Binding SelectedEncoderProfile, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  IsEnabled="{Binding IsProfileSelectionEnabled}">

                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="profileModels:EncoderProfile">
                                    <StackPanel Orientation="Horizontal" Spacing="12">

                                        <!-- Encoder Icon -->
                                        <Image Width="20" Height="20"
                                           Source="{Binding Name, Converter={StaticResource EncoderNameToIconConverter}}"/>

                                        <!-- Encoder Name + Description -->
                                        <StackPanel Spacing="2" MaxWidth="480">
                                            <TextBlock Text="{x:Bind Name}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                            <TextBlock Text="{x:Bind Description}"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="500"/>
                                        </StackPanel>

                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>

                    </StackPanel>


                    <!-- CLIENT PROFILE -->
                    <StackPanel Width="360" Spacing="6">

                        <TextBlock Text="Client Profile"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>

                        <ComboBox Width="360"
                                  ItemContainerStyleSelector="{StaticResource ComboBoxContainerStyleSelector}"
                                  ItemTemplateSelector="{StaticResource ComboBoxItemTemplateSelector}"
                                  ItemsSource="{Binding ClientProfiles, Mode=OneWay, Converter={StaticResource GroupInfoListToFlatCollectionConverter}}"
                                  SelectedItem="{Binding SelectedClientProfile, Mode=TwoWay}"/>
                    </StackPanel>


                    <!-- STATISTICS -->
                    <TextBlock VerticalAlignment="Bottom"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"
                           Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibilityConverter}}"
                           Text="{Binding ElapsedTime, Converter={StaticResource TimeSpanToStringConverter}}">
                    </TextBlock>
                </StackPanel>

                <Rectangle Height="1" Stroke="Gray" />
            </StackPanel>

            <!-- TOOLBAR -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{Binding AddFileCommand}"
                        HorizontalAlignment="Right"
                        IsEnabled="{Binding IsProfileSelectionEnabled, Mode=OneWay}"
                        Width="140">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A5;" />
                        <TextBlock Text="Add File" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding AddFolderCommand}"
                        HorizontalAlignment="Right"
                        IsEnabled="{Binding IsProfileSelectionEnabled, Mode=OneWay}"
                        Width="140">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" />
                        <TextBlock Text="Add Folder" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding StartQueueCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{Binding IsProfileSelectionEnabled, Mode=OneWay}"
                        Width="160"
                        Margin="24,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xF0E2;" />
                        <TextBlock Text="Start Queue" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ClearCompletedCommand}"
                        IsEnabled="{Binding IsProfileSelectionEnabled, Mode=OneWay}"
                        Width="160">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE73E;" />
                        <TextBlock Text="Clear Completed" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ClearAllCommand}"
                        Style="{StaticResource DefaultButtonStyle}"
                        IsEnabled="{Binding IsProfileSelectionEnabled, Mode=OneWay}"
                        Width="160">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE75C;" />
                        <TextBlock Text="Clear All" />
                    </StackPanel>
                </Button>

                <CheckBox Content="Auto Clear Completed"
                          IsChecked="{Binding AutoClearCompleted, Mode=TwoWay}"
                          IsEnabled="{Binding IsProfileSelectionEnabled, Mode=OneWay}"
                          VerticalAlignment="Center">
                </CheckBox>
            </StackPanel>

            <!-- QUEUE STATUS SUMMARY -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="#4C6EF5" Padding="6,3" CornerRadius="6">
                    <TextBlock FontWeight="SemiBold" Foreground="White">
                        <Run Text=" Total "/>
                        <Run Text="{Binding TotalItems, Mode=OneWay}" />
                    </TextBlock>
                </Border>

                <Border Background="#2F9E44" Padding="6,3" CornerRadius="6">
                    <TextBlock FontWeight="SemiBold" Foreground="White">
                        <Run Text=" Completed "/>
                        <Run Text="{Binding CompletedItems, Mode=OneWay}" />
                    </TextBlock>
                </Border>

                <Border Background="#0B7285" Padding="6,3" CornerRadius="6">
                    <TextBlock FontWeight="SemiBold" Foreground="White">
                        <Run Text=" Running "/>
                        <Run Text="{Binding RunningItems, Mode=OneWay}" />
                    </TextBlock>
                </Border>

                <Border Background="#F59F00" Padding="6,3" CornerRadius="6">
                    <TextBlock FontWeight="SemiBold" Foreground="White">
                        <Run Text=" Pending "/>
                        <Run Text="{Binding PendingItems, Mode=OneWay}" />
                    </TextBlock>
                </Border>

                <Border Background="#D6336C" Padding="6,3" CornerRadius="6">
                    <TextBlock FontWeight="SemiBold" Foreground="White">
                        <Run Text=" Failed "/>
                        <Run Text="{Binding FailedItems, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </StackPanel>

        </StackPanel>

        <!-- QUEUE LIST -->
        <ScrollView Grid.Row="1" Margin="0,16">
            <ItemsRepeater ItemsSource="{Binding Items}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:QueueItem">

                        <Grid CornerRadius="14"
                              Padding="18"
                              Background="{ThemeResource SystemControlAcrylicWindowBrush}"
                              Margin="0,0,0,20">
                            <Grid.Shadow>
                                <ThemeShadow/>
                            </Grid.Shadow>

                            <StackPanel Spacing="16">

                                <!-- HEADER -->
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind File.FileName}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                        <!-- ACTION BADGE -->
                                        <Border Background="{x:Bind Task.Decision.IsDirectPlay, Converter={StaticResource BoolToColorConverter}}"
                                            CornerRadius="6"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Task.Decision.ModeLabel}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- ENCODER BADGE -->
                                        <Border Background="{x:Bind Task.Decision.EncoderType, Mode=OneWay, Converter={StaticResource EncoderTypeToColorConverter}}"
                                            CornerRadius="6"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <ContentControl Content="{x:Bind Task.Decision.EncoderType, Mode=OneWay, Converter={StaticResource EncoderTypeToSvgIconConverter}}" />
                                                <TextBlock Text="{x:Bind Task.Decision.EncoderType, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- PLAYBACK QUALITY BADGE -->
                                        <Border Background="{x:Bind Task.Decision.PlaybackQualityColor, Mode=OneWay}"
                                            CornerRadius="6"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind Task.Decision.PlaybackQualityIcon}"
                                                      FontSize="16" />
                                                <TextBlock Text="{x:Bind Task.Decision.PlaybackQuality, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- COMPLIANCE BADGE -->
                                        <Border Background="{x:Bind IsCompliant, Mode=OneWay, Converter={StaticResource BoolToColorConverter}}"
                                            Visibility="{x:Bind IsConverted, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ComplianceErrorsString, Mode=OneWay}"
                                            CornerRadius="6"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ComplianceDisplay, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                        </Border>

                                        <!-- File Size BADGE -->
                                        <Border Background="{x:Bind SizeChange, Mode=OneWay, Converter={StaticResource LongToColorConverter}}"
                                            Visibility="{x:Bind IsConverted, Mode=OneWay}"
                                            CornerRadius="6"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SizeChange, Mode=OneWay, Converter={StaticResource LongToFileSizeConverter}}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                        </Border>
                                        
                                        <!-- REMOVE BUTTON -->
                                        <Button Command="{Binding DataContext.RemoveItemCommand, ElementName=RootPage}"
                                            CommandParameter="{x:Bind}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTipService.ToolTip="Remove from queue"
                                            HorizontalAlignment="Right"
                                            Margin="12,0,0,0">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind Task.OutputFileName, Mode=OneWay}" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind Task.ErrorMessage, Mode=OneWay}" Opacity="0.7" />
                                </StackPanel>

                                <!-- STATUS + CANCEL -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                               FontSize="16"
                                               Foreground="Gray"/>

                                    <TextBlock Text="{x:Bind EstimatedTimeRemaining, Mode=OneWay, Converter={StaticResource TimeSpanToStringConverter}}"
                                               FontSize="16"
                                               Foreground="Gray"/>


                                    <TextBlock Text="{x:Bind CurrentFPS, Mode=OneWay, Converter={StaticResource DoubleToCurrentFpsStringConverter}}"
                                               FontSize="16"
                                               Foreground="Gray"/>

                                    <TextBlock Text="{x:Bind SpeedX, Mode=OneWay, Converter={StaticResource DoubleToSpeedXStringConverter}}"
                                               FontSize="16"
                                               Foreground="Gray"/>

                                    <TextBlock Text="{x:Bind Progress, Mode=OneWay, Converter={StaticResource DoubleToProgressConverter}}"
                                               FontSize="16"
                                               Foreground="Gray"/>

                                    <Button Content="Cancel"
                                            Command="{Binding DataContext.CancelItemCommand, ElementName=RootPage}"
                                            CommandParameter="{x:Bind}"
                                            Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                </StackPanel>

                                <!-- PROGRESS -->
                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}"
                                             Height="6"
                                             Minimum="0"
                                             Maximum="100"/>

                                <!-- SUMMARY GRID -->
                                <controls:DecisionSummaryControl Decision="{x:Bind Task.Decision}" />


                                <!-- ADVANCED DETAILS (COLLAPSIBLE) -->
                                <Expander Header="Advanced Details" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="6">

                                        <ItemsControl ItemsSource="{x:Bind Task.Decision.Reasons, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" FontSize="13" Foreground="Gray"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </Grid>

                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollView>

    </Grid>

</Page>

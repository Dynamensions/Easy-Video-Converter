<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Dynamensions.EasyVideoConverter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:Dynamensions.EasyVideoConverter"
    xmlns:converters="using:Dynamensions.EasyVideoConverter.Converters"
    xmlns:behaviors="using:Dynamensions.EasyVideoConverter.Behaviors">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:TimespanToVisibilityConverter x:Key="TimespanToVisibilityConverter"/>
            
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
            <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter"/>
            <converters:DoubleToCurrentFpsStringConverter x:Key="DoubleToCurrentFpsStringConverter"/>
            <converters:DoubleToSpeedXStringConverter x:Key="DoubleToSpeedXStringConverter"/>

            <converters:DoubleToProgressConverter x:Key="DoubleToProgressConverter" />
            
            <Style x:Key="BadgeStyle" TargetType="Border">
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="ChildTransitions">
                    <Setter.Value>
                        <TransitionCollection>
                            <EntranceThemeTransition/>
                        </TransitionCollection>
                    </Setter.Value>
                </Setter>
            </Style>


        </ResourceDictionary>
    </Application.Resources>
</Application>
